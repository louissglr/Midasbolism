import os
import pandas as pd

configfile: "../config/config-glicid-scratch.yml"


# Outputs for rule all()
def all_outputs():
    outputs = []

    for model in config["models"]:

        outputs.append(
            f"{config['outDir']}/{model}/pca_fs/{model}_pca.tsv"
        )

        outputs.append(
            f"{config['outDir']}/{model}/pca_fs/{model}_pca.png"
        )

        outputs.append(
            f"{config['outDir']}/{model}/umap_fs/{model}_umap.tsv"
        )

        outputs.append(
            f"{config['outDir']}/{model}/umap_fs/{model}_umap.png"
        )

        outputs.append(
            f"{config['outDir']}/{model}/rcc/{model}_rcc.png"
        )

        outputs.append(
            f"{config['outDir']}/{model}/rcc/{model}_rcc_with_gp.png"
        )

        outputs.append(
            f"{config['outDir']}/{model}/gapfilling/{model}_gapfilled.tsv"
        )

        outputs.append(
            f"{config['outDir']}/{model}/report/{model}.report.html"
        )

        outputs.append(
            f"{config['outDir']}/all/pca_median_fs/median_flux_matrix.tsv"
        )

        outputs.append(
            f"{config['outDir']}/all/pca_median_fs/pca.tsv"
        )
        outputs.append(
            f"{config['outDir']}/all/pca_median_fs/pca.png"
        )
        outputs.append(
            f"{config['outDir']}/all/pca_all_fs/pca_all_fs.png"
        )
    return outputs


# RULE ALL
rule all:
    input:
        all_outputs()



# PCA
rule pc_fs:
    input:
        fs=f"{config['dataDir']}/models/{{models}}/fs/fs_{{models}}.tsv"
    output:
        pca=f"{config['outDir']}/{{models}}/pca_fs/{{models}}_pca.tsv",
        var = f"{config['outDir']}/{{models}}/pca_fs/{{models}}_pca_var.tsv",
    log:
        f"{config['outDir']}/log/pca_fs/{{models}}_pca.log"
    params:
        n=20000,
        seed=42,
        sampling=False  
    conda:
        "envs/env.yml"
    threads: 3
    script:
        "scripts/pca_fs.R"


rule plot_pca:
    input:
        pca=f"{config['outDir']}/{{models}}/pca_fs/{{models}}_pca.tsv",
        var=f"{config['outDir']}/{{models}}/pca_fs/{{models}}_pca_var.tsv"
    output:
        png=f"{config['outDir']}/{{models}}/pca_fs/{{models}}_pca.png"
    conda:
        "envs/env.yml"
    threads: 1
    script:
        "scripts/plot_pca.R"


#UMAP (on PCs)
