import os
import pandas as pd

configfile: "../config/config-glicid-scratch.yml"


# Outputs for rule all()
def all_outputs():
    outputs = []

    for model in config["models"]:

        outputs.append(
            f"{config['outDir']}/{model}/pca_fs/{model}_pca.tsv"
        )

        outputs.append(
            f"{config['outDir']}/{model}/pca_fs/{model}_pca.png"
        )

        outputs.append(
            f"{config['outDir']}/{model}/umap_fs/{model}_umap.tsv"
        )

        outputs.append(
            f"{config['outDir']}/{model}/umap_fs/{model}_umap.png"
        )

        outputs.append(
            f"{config['outDir']}/{model}/report/{model}.report.html"
        )
        outputs.append(
            f"{config['outDir']}/{model}/fs_sampled/fs_sampled_{model}.tsv"
        )
        # outputs.append(
        #     f"{config['outDir']}/{model}/pcoa_fs/{model}_pcoa.tsv"
        # )


    return outputs


# RULE ALL
rule all:
    input:
        all_outputs()


# PCA
rule pc_fs:
    input:
        fs=f"{config['dataDir']}/models/{{models}}/fs/fs_{{models}}.tsv",
        sampled=f"{config['outDir']}/{{models}}/fs_sampled/fs_sampled_{{models}}.tsv"
    output:
        pca=f"{config['outDir']}/{{models}}/pca_fs/{{models}}_pca.tsv"
    conda:
        "envs/env.yml"
    threads: 1
    script:
        "scripts/pca_fs.R"


rule plot_pca:
    input:
        pca=f"{config['outDir']}/{{models}}/pca_fs/{{models}}_pca.tsv"
    output:
        png=f"{config['outDir']}/{{models}}/pca_fs/{{models}}_pca.png"
    conda:
        "envs/env.yml"
    threads: 1
    script:
        "scripts/plot_pca.R"


#UMAP (on PCA)
rule umap_fs:
    input:
        pca=f"{config['outDir']}/{{models}}/pca_fs/{{models}}_pca.tsv"
    output:
        umap=f"{config['outDir']}/{{models}}/umap_fs/{{models}}_umap.tsv"
    conda:
        "envs/env.yml"
    threads: 1
    script:
        "scripts/umap_fs.R"


rule plot_umap:
    input:
        umap=f"{config['outDir']}/{{models}}/umap_fs/{{models}}_umap.tsv"
    output:
        png=f"{config['outDir']}/{{models}}/umap_fs/{{models}}_umap.png"
    conda:
        "envs/env.yml"
    threads: 1
    script:
        "scripts/plot_umap.R"


# random sampling ids
rule sample_fs:
    input:
        fs=f"{config['dataDir']}/models/{{models}}/fs/fs_{{models}}.tsv"
    output:
        sampled=f"{config['outDir']}/{{models}}/fs_sampled/fs_sampled_{{models}}.tsv"
    params:
        n=10000,
        seed=42
    conda:
        "envs/env.yml"
    threads: 1
    script:
        "scripts/sample_fs.R"

