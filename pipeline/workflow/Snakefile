# script adapted to Louis Paré
rule plot_rcc_gp:
    input:
        fs=f"{config['dataDir']}/models/{{models}}/fs/fs_{{models}}.tsv",
        gp_status=f"{config['outDir']}/{{models}}/gapfilling/{{models}}_gapfilled.tsv"
    output:
        png=f"{config['outDir']}/{{models}}/rcc/{{models}}_rcc_with_gp.png"
    conda:
        "envs/env.yml"
    threads: 1
    script:
        "scripts/plot_rcc_gp.R"



rule flag_gapfilled:
    input:
        carveme=f"{config['dataDir']}/models/{{models}}/stats/carveme.reactions.list",
        srp=f"{config['dataDir']}/models/{{models}}/stats/srp.reactions.list"
    output:
        tsv=f"{config['outDir']}/{{models}}/gapfilling/{{models}}_gapfilled.tsv"
    conda:
        "envs/env.yml"
    threads: 1
    script:
        "scripts/flag_gapfilled.R"


rule median_flux_matrix:
    input:
        expand(
            f"{config['dataDir']}/models/{{model}}/fs/fs_{{model}}.tsv",
            model=config["models"]
        )
    output:
        tsv=f"{config['outDir']}/all/pca_median_fs/median_flux_matrix.tsv"
    log:
        f"{config['outDir']}/log/median_fs/median_flux_matrix.log"
    conda:
        "envs/env.yml"
    script:
        "scripts/median_flux_matrix.R"


