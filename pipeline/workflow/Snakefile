#HTML reports for each models
rule render_report:
    input:
        qmd="scripts/report_humess.qmd",
        fs=f"{config['dataDir']}/models/{{models}}/fs/fs_{{models}}.tsv",
        pca=f"{config['outDir']}/{{models}}/pca_fs/{{models}}_pca.tsv",
        umap=f"{config['outDir']}/{{models}}/umap_fs/{{models}}_umap.tsv",
        png_pca=f"{config['outDir']}/{{models}}/pca_fs/{{models}}_pca.png",
        png_umap=f"{config['outDir']}/{{models}}/umap_fs/{{models}}_umap.png"

    output:
        html=report(
            f"{config['outDir']}/{{models}}/report/{{models}}.report.html",
            category="{models}",
            labels={"model": "{models}"}
        )

    params:
        outdir=f"{config['outDir']}/{{models}}/report",
        models="{models}"

    conda:
        "envs/quarto.yml"

    threads: 1

    log:
        f"{config['outDir']}/{{models}}/report/render_report.log"

    shell:
        r"""
        mkdir -p "{params.outdir}"

        export TMPDIR="${{TMPDIR:-/tmp}}"
        export DENO_DIR="$TMPDIR/quarto-deno-cache-{wildcards.models}"
        export XDG_CACHE_HOME="$TMPDIR/quarto-xdg-cache-{wildcards.models}"

        cp "{input.qmd}" "{params.outdir}/report_humess.qmd"

        cd "{params.outdir}"

        quarto render report_humess.qmd \
            --output "{wildcards.models}.report.html" \
            -P models:"{params.models}" \
            -P outdir:"{params.outdir}" \
            -P fs_file:"{input.fs}" \
            -P png_pca:"{input.png_pca}" \
            -P png_umap:"{input.png_umap}" \
            > "{log}" 2>&1

        rm -f report_humess.qmd
        """